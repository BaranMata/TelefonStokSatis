erDiagram
    %% Günlük tabloları: audit_logs.tenant_id/user_id FK; error_logs, backup_logs ve mail_outbox bağımsız kayıtlardır.
    AUDIT_LOGS {
        int id PK
        int tenant_id FK
        int user_id FK
        text action
        text entity
        int entity_id
        json details
        text ip
    }
    ERROR_LOGS {
        int id PK
        int tenant_id
        int user_id
        text method
        text path
        int status
        text message
        text stack
    }
    BACKUP_LOGS {
        int id PK
        text file_name
        int size_bytes
        text kind "auto|manual|pre_restore|restore"
        int user_id
        text created_at
    }
    MAIL_OUTBOX {
        int id PK
        text to_email
        text subject
        text body
        text created_at
    }
